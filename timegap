import re
import sys


def to_seconds(text):
    if re.fullmatch(r"[0-9]{2}:[0-9]{2}:[0-9]{2}", text) is None:
        raise ValueError("時刻はHH:MM:SS形式で入力してください")

    hour, minute, second = map(int, text.split(":"))

    if hour > 23 or minute > 59 or second > 59:
        raise ValueError("時刻の範囲が正しくありません")

    return hour * 3600 + minute * 60 + second


def main():
    if len(sys.argv) != 1:
        print("使い方: timegap < times.txt", file=sys.stderr)
        return 1

    previous = None

    for line_number, line in enumerate(sys.stdin, start=1):
        text = line.rstrip("\r\n")

        try:
            current = to_seconds(text)

            if previous is not None:
                if current < previous:
                    raise ValueError("時刻が逆戻りしています")

                print(current - previous)

            previous = current

        except ValueError as error:
            print(f"{line_number}行目: {error}", file=sys.stderr)
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
